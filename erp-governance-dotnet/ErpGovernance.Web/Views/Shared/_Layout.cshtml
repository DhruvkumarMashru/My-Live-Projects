@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery
@inject ErpGovernance.Application.Interfaces.ICurrentUserService CurrentUser
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@using ErpGovernance.Application.Constants
@using Microsoft.AspNetCore.Authorization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP Governance</title>
    <meta name="csrf-token" content="@antiforgery.GetAndStoreTokens(Context).RequestToken">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .glass { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.3); }
        .sidebar-active { background-color: #1e293b; border-left: 4px solid #6366f1; color: white; }
        .sidebar-link { transition: all 0.2s ease-in-out; }
        .sidebar-link:hover { background-color: #1e293b; color: white; }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="text-slate-800 antialiased h-screen flex overflow-hidden">
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Sidebar -->
        <aside class="w-64 bg-slate-900 text-slate-300 flex flex-col shadow-2xl z-20 h-full flex-shrink-0">
            <div class="h-16 flex items-center px-6 border-b border-slate-800">
                <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-cyan-400">
                    ERP Governance
                </span>
            </div>
            
            <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
                <a href="/Dashboard" class="sidebar-link group flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewData["ActiveNav"] as string == "Dashboard" ? "sidebar-active" : "")">
                    <svg class="mr-3 h-5 w-5 text-slate-400 group-hover:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    Dashboard
                </a>
                <a href="/Projects" class="sidebar-link group flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewData["ActiveNav"] as string == "Projects" ? "sidebar-active" : "")">
                    <svg class="mr-3 h-5 w-5 text-slate-400 group-hover:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                    Projects
                </a>
                
                @if((await AuthorizationService.AuthorizeAsync(User, Permissions.Organizations.View)).Succeeded || (await AuthorizationService.AuthorizeAsync(User, Permissions.Users.View)).Succeeded || (await AuthorizationService.AuthorizeAsync(User, Permissions.Roles.View)).Succeeded)
                {
                    <p class="px-3 pt-4 pb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">Administration</p>
                    @if((await AuthorizationService.AuthorizeAsync(User, Permissions.Organizations.View)).Succeeded)
                    {
                        <a href="/Organizations" class="sidebar-link group flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewData["ActiveNav"] as string == "Organizations" ? "sidebar-active" : "")">
                            <svg class="mr-3 h-5 w-5 text-slate-400 group-hover:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                            Organizations
                        </a>
                    }
                    @if((await AuthorizationService.AuthorizeAsync(User, Permissions.Users.View)).Succeeded)
                    {
                        <a href="/Users" class="sidebar-link group flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewData["ActiveNav"] as string == "Users" ? "sidebar-active" : "")">
                            <svg class="mr-3 h-5 w-5 text-slate-400 group-hover:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                            Users
                        </a>
                    }
                    @if((await AuthorizationService.AuthorizeAsync(User, Permissions.Roles.View)).Succeeded)
                    {
                        <a href="/Roles" class="sidebar-link group flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewData["ActiveNav"] as string == "Roles" ? "sidebar-active" : "")">
                            <svg class="mr-3 h-5 w-5 text-slate-400 group-hover:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            Roles & Permissions
                        </a>
                    }
                }
                
                <p class="px-3 pt-4 pb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">Tools</p>
                <a href="/Reports" class="sidebar-link group flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewData["ActiveNav"] as string == "Reports" ? "sidebar-active" : "")">
                    <svg class="mr-3 h-5 w-5 text-slate-400 group-hover:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Reports
                </a>
                @if((await AuthorizationService.AuthorizeAsync(User, Permissions.Import.Execute)).Succeeded)
                {
                    <a href="/Import" class="sidebar-link group flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewData["ActiveNav"] as string == "Import" ? "sidebar-active" : "")">
                        <svg class="mr-3 h-5 w-5 text-slate-400 group-hover:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                        Import CSV
                    </a>
                }
                
                @if((await AuthorizationService.AuthorizeAsync(User, Permissions.Audit.View)).Succeeded)
                {
                    <a href="/Audit" class="sidebar-link group flex items-center px-3 py-2 text-sm font-medium rounded-md @(ViewData["ActiveNav"] as string == "Audit" ? "sidebar-active" : "")">
                        <svg class="mr-3 h-5 w-5 text-slate-400 group-hover:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                        Audit Logs
                    </a>
                }
            </nav>
            
            <!-- User Menu -->
            <div class="p-4 border-t border-slate-800 bg-slate-900/50">
                <div class="flex items-center">
                    <div class="h-9 w-9 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold shadow-inner">
                        @(string.IsNullOrEmpty(CurrentUser.UserName) ? "U" : CurrentUser.UserName.Substring(0, 1).ToUpper())
                    </div>
                    <div class="ml-3 flex-1 overflow-hidden">
                        <p class="text-sm font-medium text-white truncate">@CurrentUser.UserName</p>
                        <p class="text-xs text-indigo-300 truncate">@DisplayHelpers.RoleLabel(CurrentUser.Role)</p>
                    </div>
                </div>
                <form method="post" action="/Account/Logout" class="mt-4">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full flex items-center justify-center px-4 py-2 text-sm font-medium text-slate-300 bg-slate-800 hover:bg-rose-600 hover:text-white rounded-md transition-colors">
                        <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        Sign out
                    </button>
                </form>
            </div>
        </aside>
    }

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col h-full overflow-hidden w-full relative">
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Top Header -->
            <header class="h-16 bg-white/80 backdrop-blur-md border-b border-slate-200 flex items-center justify-between px-8 z-10 shadow-sm flex-shrink-0">
                <div class="flex items-center">
                    <h1 class="text-xl font-semibold text-slate-800">@ViewData["Title"]</h1>
                    @if (ViewData["Breadcrumb"] != null)
                    {
                        <span class="mx-3 text-slate-300">/</span>
                        <span class="text-sm text-slate-500 font-medium">@ViewData["Breadcrumb"]</span>
                    }
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/Notifications" class="relative text-slate-400 hover:text-indigo-500 transition-colors">
                        <span class="sr-only">Notifications</span>
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                    </a>
                </div>
            </header>

            <!-- Demo Data Toolbar -->
            <div x-data="{ open: true }" x-show="open" class="flex-shrink-0 bg-gradient-to-r from-amber-500/15 via-orange-500/10 to-amber-500/15 border-b border-amber-400/30 px-8 py-2.5 flex items-center justify-between gap-4 flex-wrap">
                <div class="flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4 text-amber-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                    <span class="font-semibold text-amber-700">Demo Mode</span>
                    <span class="text-slate-500 text-xs hidden sm:inline">— Populate the app with realistic sample data, or remove it when done.</span>
                </div>
                <div class="flex items-center gap-3">
                    <form method="post" action="/DemoData/Seed" class="inline" onsubmit="return confirm('This will seed demo organizations, projects, modules, checklists and activities. Continue?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" id="btn-seed-demo"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-semibold rounded-lg shadow-sm transition-all">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                            Seed Demo Data
                        </button>
                    </form>
                    <form method="post" action="/DemoData/Remove" class="inline" onsubmit="return confirm('This will permanently remove ALL demo data. Continue?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" id="btn-remove-demo"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-rose-500 hover:bg-rose-600 text-white text-xs font-semibold rounded-lg shadow-sm transition-all">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            Remove Demo Data
                        </button>
                    </form>
                    <button type="button" @@click="open = false" class="text-slate-400 hover:text-slate-600 transition-colors p-1" title="Dismiss bar">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
            </div>
        }

        <!-- Page Content Scrollable Area -->
        <main class="flex-1 overflow-y-auto bg-slate-50 relative p-8">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <!-- AJAX Slide-in Modal Container -->
    <partial name="_DashboardModal" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
