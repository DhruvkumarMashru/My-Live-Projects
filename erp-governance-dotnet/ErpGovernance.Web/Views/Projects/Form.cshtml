@model ErpGovernance.Application.DTOs.ProjectFormDto
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Project" : "Create Project";
    ViewData["ActiveNav"] = "Projects";
    ViewData["Breadcrumb"] = isEdit ? "Edit" : "Create";
}

<div class="max-w-3xl mx-auto bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">
        <h3 class="text-lg leading-6 font-medium text-slate-900">Project Information</h3>
        <p class="mt-1 text-sm text-slate-500">Provide the foundational details for this ERP implementation project.</p>
    </div>
    
    <div class="p-6">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="space-y-6">
            @if(isEdit) { <input type="hidden" asp-for="Id" /> }
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 rounded-lg p-3"></div>

            <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                
                <div class="sm:col-span-4">
                    <label asp-for="Name" class="block text-sm font-medium text-slate-700">Project Name <span class="text-rose-500">*</span></label>
                    <div class="mt-1">
                        <input asp-for="Name" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    </div>
                    <span asp-validation-for="Name" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Code" class="block text-sm font-medium text-slate-700">Project Code</label>
                    <div class="mt-1">
                        <input asp-for="Code" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" placeholder="e.g. ERP-2026" />
                    </div>
                    <span asp-validation-for="Code" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="OrganizationId" class="block text-sm font-medium text-slate-700">Organization <span class="text-rose-500">*</span></label>
                    <div class="mt-1">
                        <select asp-for="OrganizationId" asp-items="ViewBag.Organizations" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md">
                            <option value="">-- Select Organization --</option>
                        </select>
                    </div>
                    <span asp-validation-for="OrganizationId" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-6">
                    <label asp-for="Description" class="block text-sm font-medium text-slate-700">Description</label>
                    <div class="mt-1">
                        <textarea asp-for="Description" rows="3" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></textarea>
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="ExpectedStartDate" class="block text-sm font-medium text-slate-700">Expected Start Date</label>
                    <div class="mt-1">
                        <input asp-for="ExpectedStartDate" type="date" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="ExpectedEndDate" class="block text-sm font-medium text-slate-700">Expected End Date</label>
                    <div class="mt-1">
                        <input asp-for="ExpectedEndDate" type="date" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="Priority" class="block text-sm font-medium text-slate-700">Priority</label>
                    <div class="mt-1">
                        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<ErpGovernance.Domain.Enums.Priority>()" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></select>
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="Status" class="block text-sm font-medium text-slate-700">Status</label>
                    <div class="mt-1">
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ErpGovernance.Domain.Enums.ItemStatus>()" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></select>
                    </div>
                </div>

                <div class="sm:col-span-6 border-t border-slate-200 pt-6 mt-2">
                    <label class="block text-sm font-medium text-slate-700 mb-2">Project Managers</label>
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 max-h-48 overflow-y-auto">
                        @if (ViewBag.Managers != null)
                        {
                            <div class="space-y-2">
                                @foreach (var m in ViewBag.Managers)
                                {
                                    var isChecked = Model.ManagerIds.Contains(int.Parse(m.Value));
                                    <div class="flex items-start">
                                        <div class="flex items-center h-5">
                                            <input type="checkbox" name="ManagerIds" value="@m.Value" checked="@isChecked" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-slate-300 rounded">
                                        </div>
                                        <div class="ml-3 text-sm">
                                            <label class="font-medium text-slate-700">@m.Text</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500 italic">No managers found.</p>
                        }
                    </div>
                </div>

            </div>

            <div class="pt-5 flex justify-end gap-3 border-t border-slate-200">
                <a href="/Projects" class="bg-white py-2 px-4 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Cancel
                </a>
                <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">
                    Save Project
                </button>
            </div>
        </form>
    </div>
</div>
