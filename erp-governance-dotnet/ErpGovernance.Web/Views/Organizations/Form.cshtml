@model ErpGovernance.Application.DTOs.OrganizationFormDto
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Organization" : "Create Organization";
    ViewData["ActiveNav"] = "Organizations";
    ViewData["Breadcrumb"] = isEdit ? "Edit" : "Create";
}

<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">
        <h3 class="text-lg leading-6 font-medium text-slate-900">Organization Details</h3>
    </div>
    
    <div class="p-6">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="space-y-6">
            @if(isEdit) { <input type="hidden" asp-for="Id" /> }
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 rounded-lg p-3"></div>

            <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                <div class="sm:col-span-4">
                    <label asp-for="Name" class="block text-sm font-medium text-slate-700">Organization Name <span class="text-rose-500">*</span></label>
                    <div class="mt-1">
                        <input asp-for="Name" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    </div>
                    <span asp-validation-for="Name" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Code" class="block text-sm font-medium text-slate-700">Code</label>
                    <div class="mt-1">
                        <input asp-for="Code" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md uppercase" />
                    </div>
                    <span asp-validation-for="Code" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-6">
                    <label asp-for="Address" class="block text-sm font-medium text-slate-700">Address</label>
                    <div class="mt-1">
                        <textarea asp-for="Address" rows="3" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></textarea>
                    </div>
                </div>

                <div class="sm:col-span-6">
                    <div class="flex items-center">
                        <input asp-for="IsActive" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-slate-300 rounded" />
                        <label asp-for="IsActive" class="ml-2 block text-sm text-slate-900">Active (Allows login and project assignment)</label>
                    </div>
                </div>
            </div>

            <div class="pt-5 flex justify-end gap-3 border-t border-slate-200">
                <a href="/Organizations" class="bg-white py-2 px-4 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">Cancel</a>
                <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">Save</button>
            </div>
        </form>
    </div>
</div>
