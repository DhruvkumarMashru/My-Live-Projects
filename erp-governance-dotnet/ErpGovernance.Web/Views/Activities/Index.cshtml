@model List<ErpGovernance.Application.DTOs.ActivityListDto>
@{
    ViewData["Title"] = "Activities";
    ViewData["ActiveNav"] = "Projects";
    var checklistId = ViewBag.ChecklistId;
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <a href="javascript:history.back()" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 mb-2 inline-block">&larr; Back to Checklist</a>
        <h2 class="text-2xl font-bold text-slate-800">Activities</h2>
        <p class="text-sm text-slate-500 mt-1">Level 5: Executable tasks, communications, and sign-offs.</p>
    </div>
    <a href="/Activities/Create?checklistId=@checklistId" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
        New Activity
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
            <tr>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Activity Title</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Assignment</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Progress</th>
                <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-200">
            @if (!Model.Any()) {
                <tr><td colspan="5" class="px-6 py-8 text-center text-slate-500">No activities created yet.</td></tr>
            }
            @foreach (var a in Model)
            {
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-bold text-slate-900">@a.Title</div>
                        <div class="text-xs text-slate-500 mt-1 flex items-center gap-2">
                            <span class="bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-mono border border-slate-200">@a.ActivityType</span>
                            <span class="@ErpGovernance.Web.Helpers.DisplayHelpers.PriorityBadgeClass(a.Priority.ToString().ToLower())">@a.Priority</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-slate-700">@(a.AssignedUserName ?? "Unassigned")</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="@ErpGovernance.Web.Helpers.DisplayHelpers.StatusBadgeClass(a.Status.ToString().ToLower())">@ErpGovernance.Web.Helpers.DisplayHelpers.StatusLabel(a.Status.ToString().ToLower())</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <div class="w-24 bg-slate-200 rounded-full h-2 mr-3 overflow-hidden shadow-inner">
                                <div class="@ErpGovernance.Web.Helpers.DisplayHelpers.ProgressColorClass(a.ProgressPercentage) h-2 rounded-full" style="width: @a.ProgressPercentage%"></div>
                            </div>
                            <span class="text-xs font-bold text-slate-700">@a.ProgressPercentage%</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <a href="/Activities/Detail/@a.Id" class="text-indigo-600 hover:text-indigo-950 font-semibold mr-3">View</a>
                        <a href="/Activities/Edit/@a.Id" class="text-amber-600 hover:text-amber-950 font-semibold mr-3">Edit</a>
                        <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this activity?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-rose-600 hover:text-rose-950 font-semibold">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (ViewBag.LegacyLogs != null && ((List<ErpGovernance.Domain.Entities.CommunicationLog>)ViewBag.LegacyLogs).Any())
{
    <div class="mt-12 mb-6">
        <h3 class="text-xl font-bold text-slate-800">Legacy Communication Logs (Pending Migration)</h3>
        <p class="text-sm text-slate-500 mt-1">These communications are imported from a legacy system. Edit them to convert them into trackable activities.</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Subject & Info</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Type</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Logged By</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Communication Date</th>
                    <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200">
                @foreach (var log in (List<ErpGovernance.Domain.Entities.CommunicationLog>)ViewBag.LegacyLogs)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="text-sm font-semibold text-slate-900">@log.Subject</div>
                            <div class="text-xs text-slate-500 mt-1 truncate max-w-md">@log.Summary</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-xs border border-slate-200">@log.CommunicationType</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-slate-700">@(log.LoggedBy?.FullName ?? "System")</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">
                            @log.CommunicationDate.ToString("dd-MMM-yyyy")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a href="/Activities/Create?checklistId=@checklistId&migrateCommunicationId=@log.Id" 
                               class="inline-flex items-center px-3 py-1.5 border border-indigo-600 text-xs font-semibold rounded text-white bg-indigo-600 hover:bg-indigo-700 transition-colors shadow-sm">
                                Migrate to Activity
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
