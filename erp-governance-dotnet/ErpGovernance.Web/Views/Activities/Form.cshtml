@model ErpGovernance.Application.DTOs.ActivityFormDto
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Activity" : "Create Activity";
    ViewData["ActiveNav"] = "Projects";
}

<div class="max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">
        <h3 class="text-lg leading-6 font-medium text-slate-900">Activity Details</h3>
    </div>
    
    <div class="p-6">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="space-y-6">
            @if(isEdit) { <input type="hidden" asp-for="Id" /> }
            <input type="hidden" asp-for="ChecklistId" />
            <input type="hidden" asp-for="MigrateCommunicationId" />
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 rounded-lg p-3"></div>

            <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                
                <div class="sm:col-span-4">
                    <label asp-for="Title" class="block text-sm font-medium text-slate-700">Title <span class="text-rose-500">*</span></label>
                    <input asp-for="Title" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    <span asp-validation-for="Title" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="ActivityType" class="block text-sm font-medium text-slate-700">Activity Type</label>
                    <select asp-for="ActivityType" asp-items="Html.GetEnumSelectList<ErpGovernance.Domain.Enums.ActivityType>()" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></select>
                </div>

                <div class="sm:col-span-6">
                    <label asp-for="Description" class="block text-sm font-medium text-slate-700">Description / Instructions</label>
                    <textarea asp-for="Description" rows="3" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></textarea>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="AssignedUserId" class="block text-sm font-medium text-slate-700">Assign To (User)</label>
                    <select asp-for="AssignedUserId" asp-items="ViewBag.Users" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md">
                        <option value="">-- Unassigned --</option>
                    </select>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="ResponsibleTeam" class="block text-sm font-medium text-slate-700">Responsible Team / External Party</label>
                    <input asp-for="ResponsibleTeam" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Status" class="block text-sm font-medium text-slate-700">Status</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<ErpGovernance.Domain.Enums.ItemStatus>()" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></select>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Priority" class="block text-sm font-medium text-slate-700">Priority</label>
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<ErpGovernance.Domain.Enums.Priority>()" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></select>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="ProgressPercentage" class="block text-sm font-medium text-slate-700">Progress (%)</label>
                    <input asp-for="ProgressPercentage" type="number" min="0" max="100" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    <span asp-validation-for="ProgressPercentage" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="ActualStartDateTime" class="block text-sm font-medium text-slate-700">Actual Start Date/Time</label>
                    <input asp-for="ActualStartDateTime" type="datetime-local" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="ActualEndDateTime" class="block text-sm font-medium text-slate-700">Actual End Date/Time</label>
                    <input asp-for="ActualEndDateTime" type="datetime-local" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                </div>

                <div class="sm:col-span-6 border-t border-slate-200 pt-6 mt-2">
                    <h4 class="text-sm font-medium text-slate-900 mb-4">Meeting & Communication Details</h4>
                    <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                        <div class="sm:col-span-6">
                            <label asp-for="Participants" class="block text-sm font-medium text-slate-700">Participants (Comma separated)</label>
                            <input asp-for="Participants" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                        </div>
                        <div class="sm:col-span-6">
                            <label asp-for="MeetingNotes" class="block text-sm font-medium text-slate-700">Meeting Notes / Discussion</label>
                            <textarea asp-for="MeetingNotes" rows="3" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></textarea>
                        </div>
                        <div class="sm:col-span-6">
                            <label asp-for="Outcome" class="block text-sm font-medium text-slate-700">Outcome / Resolution</label>
                            <textarea asp-for="Outcome" rows="2" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md"></textarea>
                        </div>
                        <div class="sm:col-span-3">
                            <label asp-for="NextFollowupDate" class="block text-sm font-medium text-slate-700">Next Follow-up Date</label>
                            <input asp-for="NextFollowupDate" type="date" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                        </div>
                        <div class="sm:col-span-3">
                            <label asp-for="EscalationStatus" class="block text-sm font-medium text-slate-700">Escalation Status</label>
                            <input asp-for="EscalationStatus" class="mt-1 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-5 flex justify-end gap-3 border-t border-slate-200">
                <a href="javascript:history.back()" class="bg-white py-2 px-4 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Cancel</a>
                <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">Save Activity</button>
            </div>
        </form>
    </div>
</div>
