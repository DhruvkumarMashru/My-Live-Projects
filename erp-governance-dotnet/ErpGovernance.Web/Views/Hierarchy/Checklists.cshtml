@model List<ErpGovernance.Application.DTOs.ChecklistListDto>
@{
    ViewData["Title"] = "Checklists";
    ViewData["ActiveNav"] = "Projects";
    var subModuleId = ViewBag.SubModuleId;
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <a href="javascript:history.back()" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 mb-2 inline-block">&larr; Back</a>
        <h2 class="text-2xl font-bold text-slate-800">Checklists</h2>
        <p class="text-sm text-slate-500 mt-1">Level 4: Trackable units containing actionable activities.</p>
    </div>
    <a href="/Hierarchy/ChecklistCreate?subModuleId=@subModuleId" class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
        Add Checklist
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
            <tr>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Checklist Name</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Progress</th>
                <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-200">
            @if (!Model.Any()) {
                <tr><td colspan="4" class="px-6 py-8 text-center text-slate-500">No checklists created yet.</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-bold text-slate-900">@c.Name</div>
                        <div class="text-xs text-slate-500 mt-1 flex items-center gap-2">
                            <span>Activities: @c.ActivityCount</span>
                            <span class="@ErpGovernance.Web.Helpers.DisplayHelpers.PriorityBadgeClass(c.Priority.ToString().ToLower())">@c.Priority</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="@ErpGovernance.Web.Helpers.DisplayHelpers.StatusBadgeClass(c.Status.ToString().ToLower())">@ErpGovernance.Web.Helpers.DisplayHelpers.StatusLabel(c.Status.ToString().ToLower())</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center">
                            <div class="w-24 bg-slate-200 rounded-full h-2 mr-3 overflow-hidden shadow-inner">
                                <div class="@ErpGovernance.Web.Helpers.DisplayHelpers.ProgressColorClass(c.ProgressPercentage) h-2 rounded-full" style="width: @c.ProgressPercentage%"></div>
                            </div>
                            <span class="text-xs font-bold text-slate-700">@c.ProgressPercentage%</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <div class="flex items-center justify-end gap-2">
                            <a href="/Activities?checklistId=@c.Id" class="inline-flex items-center px-3 py-1.5 border border-indigo-200 text-xs font-medium rounded text-indigo-700 bg-indigo-50 hover:bg-indigo-100 transition-colors">
                                Activities &rarr;
                            </a>
                            <a href="/Hierarchy/ChecklistEdit/@c.Id" class="inline-flex items-center px-2.5 py-1.5 border border-amber-300 text-xs font-medium rounded text-amber-700 bg-amber-50 hover:bg-amber-100 transition-colors">
                                <svg class="w-3.5 h-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>Edit
                            </a>
                            <form method="post" action="/Hierarchy/ChecklistDelete/@c.Id" class="inline" onsubmit="return confirm('Delete this checklist?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center px-2.5 py-1.5 border border-rose-300 text-xs font-medium rounded text-rose-700 bg-rose-50 hover:bg-rose-100 transition-colors">
                                    <svg class="w-3.5 h-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
