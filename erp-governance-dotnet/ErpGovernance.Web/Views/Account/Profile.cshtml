@model ErpGovernance.Application.DTOs.ProfileDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800 tracking-tight">My Profile</h1>
    <p class="text-sm text-slate-500 mt-1">Manage your account settings and password.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-lg font-medium text-slate-900 mb-4">Personal Information</h3>
        <form asp-action="Profile" method="post">
            <div class="space-y-4">
                <div>
                    <label asp-for="FullName" class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
                    <input asp-for="FullName" class="block w-full rounded-md border-slate-300 py-2 px-3 text-base focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm border" required />
                    <span asp-validation-for="FullName" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email Address (Read-only)</label>
                    <input type="text" value="@Model.Email" readonly class="block w-full rounded-md border-slate-200 bg-slate-50 text-slate-500 py-2 px-3 sm:text-sm border" />
                </div>
                <div>
                    <label asp-for="Phone" class="block text-sm font-medium text-slate-700 mb-1">Phone Number</label>
                    <input asp-for="Phone" class="block w-full rounded-md border-slate-300 py-2 px-3 text-base focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm border" />
                </div>
                <div>
                    <label asp-for="Department" class="block text-sm font-medium text-slate-700 mb-1">Department</label>
                    <input asp-for="Department" class="block w-full rounded-md border-slate-300 py-2 px-3 text-base focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm border" />
                </div>
                <div class="pt-2">
                    <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Save Profile
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <h3 class="text-lg font-medium text-slate-900 mb-4">Change Password</h3>
        <form asp-action="ChangePassword" method="post">
            <div class="space-y-4">
                <div>
                    <label asp-for="CurrentPassword" class="block text-sm font-medium text-slate-700 mb-1">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" class="block w-full rounded-md border-slate-300 py-2 px-3 text-base focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm border" required />
                </div>
                <div>
                    <label asp-for="NewPassword" class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
                    <input asp-for="NewPassword" type="password" class="block w-full rounded-md border-slate-300 py-2 px-3 text-base focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm border" required />
                </div>
                <div>
                    <label asp-for="ConfirmNewPassword" class="block text-sm font-medium text-slate-700 mb-1">Confirm New Password</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="block w-full rounded-md border-slate-300 py-2 px-3 text-base focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm border" required />
                </div>
                <div class="pt-2">
                    <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900">
                        Update Password
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
