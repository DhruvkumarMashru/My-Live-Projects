@model IEnumerable<ErpGovernance.Application.DTOs.ResponsibilityItemDto>
@using ErpGovernance.Web.Helpers

@{
    ViewData["Title"] = "Responsibility Report";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Responsibility Matrix</h1>
        <p class="text-sm text-slate-500 mt-1">Active items grouped by assigned user.</p>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 mb-6 p-4">
    <form method="get" class="flex flex-wrap items-end gap-4">
        <div class="w-full sm:w-auto">
            <label class="block text-xs font-medium text-slate-500 mb-1">Organization</label>
            <select name="orgId" asp-items="ViewBag.Orgs" class="block w-full sm:w-48 rounded-lg border-0 py-1.5 pl-3 pr-10 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6">
                <option value="">All Organizations</option>
            </select>
        </div>
        <div class="w-full sm:w-auto">
            <label class="block text-xs font-medium text-slate-500 mb-1">Project</label>
            <select name="projectId" asp-items="ViewBag.Projects" class="block w-full sm:w-48 rounded-lg border-0 py-1.5 pl-3 pr-10 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6">
                <option value="">All Projects</option>
            </select>
        </div>
        <div class="w-full sm:w-auto flex gap-2">
            <button type="submit" class="inline-flex items-center rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">Filter</button>
            <a href="/Reports/Responsibility" class="inline-flex items-center rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50">Clear</a>
        </div>
    </form>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Assigned To</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Entity</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Status & Priority</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase">Expected End</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
            @foreach (var group in Model.GroupBy(m => m.AssignedUserName).OrderBy(g => g.Key))
            {
                <tr class="bg-indigo-50/50">
                    <td colspan="4" class="px-6 py-3 text-sm font-semibold text-slate-900">@group.Key</td>
                </tr>
                @foreach (var item in group)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500 pl-10">↳</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">@item.EntityName <span class="ml-2 text-xs text-slate-500 border border-slate-200 px-1.5 py-0.5 rounded">@item.EntityType</span></td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="@DisplayHelpers.StatusBadgeClass(item.Status.ToString())">@DisplayHelpers.StatusLabel(item.Status.ToString())</span>
                            <span class="ml-2 @DisplayHelpers.PriorityBadgeClass(item.Priority.ToString())">@item.Priority.ToString()</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">@DisplayHelpers.FormatDate(item.ExpectedEndDate)</td>
                    </tr>
                }
            }
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="px-6 py-10 text-center text-slate-500">No active items assigned.</td></tr>
            }
        </tbody>
    </table>
</div>
