@model Microsoft.AspNetCore.Identity.IdentityRole<int>

@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Create Role" : "Edit Role";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight">@(isNew ? "Create New Role" : $"Edit Role: {Model.Name}")</h1>
    </div>
    <a href="/Roles" class="inline-flex items-center rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50">Back to List</a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 max-w-xl">
    <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
        <div asp-validation-summary="All" class="text-red-500 text-sm mb-4"></div>
        
        @if (!isNew)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="mb-4">
            <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-1">Role Name</label>
            <input asp-for="Name" class="block w-full rounded-md border-slate-300 py-2 px-3 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm border" required />
            <span asp-validation-for="Name" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div class="pt-4">
            <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
                Save Role
            </button>
        </div>
    </form>
</div>
