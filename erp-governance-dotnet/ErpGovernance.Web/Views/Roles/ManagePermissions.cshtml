@model ErpGovernance.Web.Controllers.ManagePermissionsViewModel

@{
    ViewData["Title"] = "Manage Permissions";
    var modules = Model.RoleClaims.GroupBy(c => c.Value.Split('.')[1]).OrderBy(g => g.Key).ToList();
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Manage Permissions</h1>
        <p class="text-sm text-slate-500 mt-1">Role: <span class="font-bold">@Model.RoleName</span></p>
    </div>
    <a href="/Roles" class="inline-flex items-center rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50">Back to List</a>
</div>

<form asp-action="ManagePermissions" method="post">
    <input type="hidden" asp-for="RoleId" />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
        @for (int m = 0; m < modules.Count; m++)
        {
            var module = modules[m];
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-slate-50 px-4 py-3 border-b border-slate-200 font-semibold text-slate-800">
                    @module.Key
                </div>
                <div class="p-4 space-y-3">
                    @{
                        var claimsList = module.ToList();
                        foreach (var claim in claimsList)
                        {
                            var globalIndex = Model.RoleClaims.IndexOf(claim);
                            var actionName = claim.Value.Split('.')[2];
                            <div class="flex items-start">
                                <div class="flex h-5 items-center">
                                    <input type="hidden" name="RoleClaims[@globalIndex].Type" value="@claim.Type" />
                                    <input type="hidden" name="RoleClaims[@globalIndex].Value" value="@claim.Value" />
                                    <input type="checkbox" name="RoleClaims[@globalIndex].Selected" value="true" checked="@claim.Selected"
                                           class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                    <input type="hidden" name="RoleClaims[@globalIndex].Selected" value="false" />
                                </div>
                                <div class="ml-3 text-sm">
                                    <label class="font-medium text-slate-700">@actionName</label>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <div class="flex gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        <button type="submit" class="inline-flex justify-center py-2 px-6 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
            Save All Permissions
        </button>
    </div>
</form>
