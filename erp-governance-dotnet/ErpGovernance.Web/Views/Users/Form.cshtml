@model ErpGovernance.Application.DTOs.UserFormDto
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit User" : "Create User";
    ViewData["ActiveNav"] = "Users";
    ViewData["Breadcrumb"] = isEdit ? "Edit" : "Create";
}

<div class="max-w-3xl mx-auto bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">
        <h3 class="text-lg leading-6 font-medium text-slate-900">User Profile Information</h3>
    </div>
    
    <div class="p-6">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="space-y-6">
            @if(isEdit) { <input type="hidden" asp-for="Id" /> }
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 bg-rose-50 rounded-lg p-3"></div>

            <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                <div class="sm:col-span-3">
                    <label asp-for="FullName" class="block text-sm font-medium text-slate-700">Full Name <span class="text-rose-500">*</span></label>
                    <div class="mt-1">
                        <input asp-for="FullName" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    </div>
                    <span asp-validation-for="FullName" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email Address <span class="text-rose-500">*</span></label>
                    <div class="mt-1">
                        <input asp-for="Email" type="email" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    </div>
                    <span asp-validation-for="Email" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="Role" class="block text-sm font-medium text-slate-700">Role <span class="text-rose-500">*</span></label>
                    <div class="mb-4">
            <label asp-for="Role" class="block text-sm font-medium text-slate-700 mb-1">System Role</label>
            <select asp-for="Role" asp-items="ViewBag.Roles" class="block w-full rounded-md border-slate-300 py-2 px-3 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm shadow-sm border" required>
                <option value="">-- Select Role --</option>
            </select>
            <span asp-validation-for="Role" class="text-red-500 text-xs mt-1 block"></span>
        </div>        </div>

                <div class="sm:col-span-3">
                    <label asp-for="OrganizationId" class="block text-sm font-medium text-slate-700">Organization (Required for non-platform roles)</label>
                    <div class="mt-1">
                        <select asp-for="OrganizationId" asp-items="ViewBag.Organizations" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md">
                            <option value="">-- Platform Level (No Org) --</option>
                        </select>
                    </div>
                    <span asp-validation-for="OrganizationId" class="text-xs text-rose-500"></span>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="Department" class="block text-sm font-medium text-slate-700">Department</label>
                    <div class="mt-1">
                        <input asp-for="Department" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    </div>
                </div>

                <div class="sm:col-span-3">
                    <label asp-for="Phone" class="block text-sm font-medium text-slate-700">Phone</label>
                    <div class="mt-1">
                        <input asp-for="Phone" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                    </div>
                </div>

                @if (!isEdit)
                {
                    <div class="sm:col-span-3">
                        <label asp-for="Password" class="block text-sm font-medium text-slate-700">Initial Password <span class="text-rose-500">*</span></label>
                        <div class="mt-1">
                            <input asp-for="Password" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                        </div>
                        <span asp-validation-for="Password" class="text-xs text-rose-500"></span>
                    </div>

                    <div class="sm:col-span-3">
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700">Confirm Password <span class="text-rose-500">*</span></label>
                        <div class="mt-1">
                            <input asp-for="ConfirmPassword" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-slate-300 rounded-md" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-500"></span>
                    </div>
                }

                <div class="sm:col-span-6">
                    <div class="flex items-center">
                        <input asp-for="IsActive" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-slate-300 rounded" />
                        <label asp-for="IsActive" class="ml-2 block text-sm text-slate-900">Account is active (can login)</label>
                    </div>
                </div>
            </div>

            <div class="pt-5 flex justify-end gap-3 border-t border-slate-200">
                <a href="/Users" class="bg-white py-2 px-4 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Cancel</a>
                <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">Save</button>
            </div>
        </form>
    </div>
</div>
